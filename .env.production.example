# En el servidor: cp .env.production.example .env  y rellenar. NO subir .env a git.
# Genera cada secreto con:  openssl rand -hex 32   (solo hex: evita caracteres que rompen la URL de la BD)

DOMAIN=becascolombia.com

POSTGRES_USER=becas
POSTGRES_PASSWORD=
POSTGRES_DB=becas

JWT_SECRET=
JWT_REFRESH_SECRET=
SCRAPER_API_KEY=

# Solo se usan al correr el seed (crea el primer admin). Contraseña larga y única.
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=

# Límites globales por IP del backend. Todo el tráfico público llega desde el contenedor
# del frontend (misma IP), por eso van altos; login, refresh e ingest conservan sus límites estrictos.
THROTTLE_SHORT_LIMIT=600
THROTTLE_MEDIUM_LIMIT=2000
THROTTLE_LONG_LIMIT=10000
