# ==========================================
# SCRAPER (Python) — copiar a .env y rellenar
# ==========================================

# Endpoint del backend para enviar datos normalizados
BACKEND_INGEST_URL=http://localhost:3000/ingest

# URL base del backend (para GET /universities)
BACKEND_URL=http://localhost:3000

# Debe coincidir con SCRAPER_API_KEY del backend
SCRAPER_API_KEY=

# Token de datos.gov.co (API Socrata) — opcional
DATOS_GOV_APP_TOKEN=

# Respeto de robots.txt (no cambiar a False sin justificación legal)
ROBOTSTXT_OBEY=True

# ---- LLM para extracción de becas ----
# Proveedor activo: gemini | glm | deepseek | nvidia
LLM_PROVIDER=gemini

# Gemini (Google AI Studio — gratuito con límites razonables)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# GLM (Zhipu AI — alternativa)
GLM_API_KEY=
GLM_MODEL=glm-4-flash

# DeepSeek (alternativa)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# NVIDIA NIM (compatible OpenAI — endpoint https://integrate.api.nvidia.com/v1)
NVIDIA_API_KEY=
NVIDIA_MODEL=

