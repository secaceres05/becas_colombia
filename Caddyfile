# Caddy pide y renueva el certificado Let's Encrypt solo.
# Para probar por IP sin dominio: DOMAIN=:80 en .env (sirve HTTP, sin SSL).
{$DOMAIN} {
	encode zstd gzip
	reverse_proxy frontend:3000
}

# Cuando el dominio ya apunte también www, descomenta:
# www.{$DOMAIN} {
# 	redir https://{$DOMAIN}{uri} permanent
# }
