# ==========================================
# BACKEND (NestJS) — copiar a .env y rellenar
# ==========================================

# ---- Base de datos ----
# Formato: postgresql://USER:PASSWORD@HOST:PORT/DB?schema=public
DATABASE_URL=postgresql://becas:CHANGE_ME@localhost:5432/becas?schema=public

# ---- Redis (cache de búsquedas) ----
REDIS_URL=redis://localhost:6380

# ---- Autenticación JWT (panel admin) ----
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# ---- Seed del primer administrador ----
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=

# ---- Comunicación con el microservicio scraper ----
# El scraper envía datos a POST /ingest con header x-api-key
SCRAPER_API_KEY=

# ---- APIs externas (rellenar cuando apliquen) ----
ICETEX_API_KEY=
DATOS_GOV_APP_TOKEN=

# ---- App ----
PORT=3000
NODE_ENV=development
